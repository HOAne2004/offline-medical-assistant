<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#DADADA"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvApptFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM LỊCH KHÁM BỆNH"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/dark_blue"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApptTitle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mục đích khám (VD: Khám tim mạch)"
            app:boxStrokeColor="@color/dark_blue"
            app:hintTextColor="@color/dark_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApptTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApptLocation"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa điểm (Tên Bệnh viện/Phòng khám)"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/dark_blue"
            app:hintTextColor="@color/dark_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApptLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApptDoctor"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên bác sĩ (Không bắt buộc)"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/dark_blue"
            app:hintTextColor="@color/dark_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApptDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApptNotes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ghi chú thêm (Cần nhịn ăn, mang sổ...)"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/dark_blue"
            app:hintTextColor="@color/dark_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApptNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày và Giờ khám"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApptSelectDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1.5"
                android:text="Ngày 15/06"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"
                app:icon="@drawable/ic_calendar"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApptSelectTime"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="08:30"
                android:textSize="20sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_time"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApptSave"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="LƯU LỊCH KHÁM"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/dark_blue"
            app:cornerRadius="16dp"/>

    </LinearLayout>
</ScrollView>